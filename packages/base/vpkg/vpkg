#!/usr/bin/env python3
# vpkg 0.6: Paketverwaltung von Veyra OS (ab 0.4 mit Versionsbedingungen in depends,
# ab 0.6 mit mehreren Quellen, Spiegeln, Paket-Cache und Gruppen).
#
# Installiert, aktualisiert und entfernt .vpkg-Pakete (Format: docs/vpkg-format.md),
# loest Abhaengigkeiten auf und fuehrt Buch darueber, welche Datei zu welchem Paket gehoert.
#
#   vpkg [--root DIR] install [--repo QUELLE] [--overwrite] [--no-deps] [--no-scripts]
#                             [--allow-downgrade] PAKET... | @GRUPPE...
#   vpkg [--root DIR] upgrade [--repo QUELLE]
#   vpkg [--root DIR] update | search MUSTER | clean [--alles] | repo list
#   vpkg [--root DIR] remove [--no-deps] NAME...
#   vpkg [--root DIR] list | info NAME | files NAME | owner PFAD | check [NAME...]
#   vpkg [--root DIR] register PAKET.vpkg...      (schon ausgepackte Pakete eintragen)
#   vpkg [--root DIR] recover                      (unterbrochenen Vorgang zuruecknehmen)
#   vpkg index [--stand ZAHL] VERZEICHNIS          (index.toml fuer ein Paket-Repository)
#
# PAKET ist eine .vpkg-Datei oder ein Paketname aus dem Repository.
# QUELLE ist ein Verzeichnis oder eine https-Adresse mit index.toml. Ohne --repo gelten die
# Quellen aus ROOT/etc/vpkg/repos.d/*.conf (ab 0.6, je Quelle ein Name und eine Liste von
# Spiegeln, siehe docs/vpkg-format.md), sonst die erste Zeile von ROOT/etc/vpkg/repo.
# Spiegel werden der Reihe nach versucht; einer mit ungueltiger Signatur oder aelterem Stand
# wird uebersprungen. Pakete aus dem Netz landen in ROOT/var/cache/vpkg/pakete und werden vor
# jeder Nutzung gegen den Index geprueft; ein abgebrochener Download bleibt als .teil liegen
# und wird nie benutzt. @GRUPPE installiert alle Pakete, die im Index die Gruppe tragen.
#
# Signaturen: Liegen oeffentliche Schluessel in ROOT/etc/vpkg/keys/*.pem (oder wird
# --pubkey angegeben), muss jedes Paket eine gueltige Ed25519-Signatur PAKET.vpkg.sig haben.
# Ab 0.3 gilt das auch fuer den Repository-Index (index.toml.sig). Sein Stand (stand = Zahl)
# darf nicht hinter den zuletzt angenommenen zuruecklaufen (ROOT/var/lib/vpkg/repo-stand.json),
# sonst koennte ein Spiegel alte, bekannt fehlerhafte Pakete als aktuell ausgeben.
# Aeltere Versionen als die installierte werden nur mit --allow-downgrade eingespielt.
#
# Transaktionen (ab 0.2): install, upgrade, remove und register schreiben jede Aenderung
# erst in ein Journal (ROOT/var/lib/vpkg/txn) und sichern ersetzte oder geloeschte Dateien.
# Scheitert ein Schritt, wird alles zurueckgenommen; bricht vpkg ab (Absturz, Stromausfall),
# nimmt der naechste schreibende Aufruf den halben Vorgang zurueck. Install-Skripte laufen
# erst danach und lassen sich nicht zuruecknehmen.
import argparse
import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import tomllib
import urllib.error
import urllib.parse
import urllib.request

VERSION = "0.6"
DB = "var/lib/vpkg"
TXN = DB + "/txn"
REPO_STAND = DB + "/repo-stand.json"
FILENAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]*\.vpkg$")
MODE_RE = re.compile(r"^[0-7]{1,4}$")
SHA_RE = re.compile(r"^[0-9a-f]{64}$")
KEYS = "etc/vpkg/keys"
REPO_FILE = "etc/vpkg/repo"
REPOS_D = "etc/vpkg/repos.d"
CACHE = "var/cache/vpkg"
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9+._-]*$")
# Abhaengigkeit: Name, optional mit Versionsbedingung (glibc>=2.42, vpkg=0.4-1, foo<2).
# Ohne "-" in der Version zaehlt nur die Version, mit "-" Version und Release.
DEP_RE = re.compile(r"^([a-z0-9][a-z0-9+._-]*?)(?:(>=|<=|=|<|>)([0-9A-Za-z][0-9A-Za-z.+~_-]*))?$")


class Fehler(Exception):
    pass


def info(msg):
    print(msg, flush=True)


def warn(msg):
    print(f"vpkg: Warnung: {msg}", file=sys.stderr, flush=True)


def signature_ok(path, sig, keys):
    """True, wenn sig eine gueltige Ed25519-Signatur von path mit einem der Schluessel ist."""
    for k in keys:
        r = subprocess.run(["openssl", "pkeyutl", "-verify", "-pubin", "-inkey", k, "-rawin",
                            "-in", path, "-sigfile", sig],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if r.returncode == 0:
            return True
    return False


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def toml_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


# ---------------------------------------------------------------- Versionen

def vercmp(a, b):
    """Vergleicht zwei Versionen wie "1.10.2-1" (Zahlen numerisch, Rest als Text)."""
    def parts(v):
        return [(0, int(x)) if x.isdigit() else (1, x) for x in re.findall(r"\d+|[A-Za-z]+", v)]
    pa, pb = parts(a), parts(b)
    for x, y in zip(pa, pb):
        if x != y:
            # Zahl gilt als neuer als Buchstaben (1.0 > 1.0rc)
            if x[0] != y[0]:
                return -1 if x[0] == 1 else 1
            return -1 if x[1] < y[1] else 1
    if len(pa) == len(pb):
        return 0
    longer, sign = (pa, 1) if len(pa) > len(pb) else (pb, -1)
    nxt = longer[min(len(pa), len(pb))]
    return sign if nxt[0] == 0 else -sign


def fullver(m):
    return f"{m['version']}-{m.get('release', 1)}"


def parse_dep(d):
    """'glibc>=2.42' -> ('glibc', '>=', '2.42'); 'bash' -> ('bash', None, None)."""
    m = DEP_RE.match(d)
    if not m:
        raise Fehler(f"ungueltige Abhaengigkeit {d!r}")
    return m.group(1), m.group(2), m.group(3)


def dep_name(d):
    return parse_dep(d)[0]


def ver_ok(m, op, ver):
    """Erfuellt das Paket (Manifest m) die Bedingung 'op ver'?"""
    cur = fullver(m) if "-" in ver else str(m["version"])
    c = vercmp(cur, ver)
    return {">=": c >= 0, "<=": c <= 0, "=": c == 0, "<": c < 0, ">": c > 0}[op]


def satisfied(d, pkgs, pmap=None):
    """Paketname, der Abhaengigkeit d unter pkgs (Name -> Manifest) erfuellt, sonst None.
    Ohne Versionsbedingung zaehlt auch provides, mit Bedingung nur das Paket selbst."""
    n, op, ver = parse_dep(d)
    if op is None:
        return (pmap if pmap is not None else provides_map(pkgs)).get(n)
    m = pkgs.get(n)
    return n if m is not None and ver_ok(m, op, ver) else None


def valid_deps(v):
    return isinstance(v, list) and all(isinstance(x, str) and DEP_RE.match(x) for x in v)


# ---------------------------------------------------------------- Pakete

class Paket:
    """Eine .vpkg-Datei, ausgepackt in ein temporaeres Verzeichnis und geprueft."""

    def __init__(self, path, tmp, keys):
        self.path = path
        self.dir = tempfile.mkdtemp(dir=tmp)
        self.check_signature(keys)
        p = subprocess.run(f"zstd -q -dc -- {sh(path)} | tar -xf - -C {sh(self.dir)}",
                           shell=True, stderr=subprocess.PIPE, text=True)
        if p.returncode != 0:
            raise Fehler(f"{path}: Archiv beschaedigt ({p.stderr.strip()})")
        # Die ausgepackte Kopie muss lesbar sein (z. B. Modus 4710 ohne root-Rechte);
        # die Rechte im Zielsystem kommen ohnehin aus dem Manifest.
        # Symlinks nie anfassen: os.walk fuehrt Links auf Verzeichnisse unter dirs, und
        # os.chmod folgt ihnen; ein absoluter Link (z. B. usr/share/X11/xkb) zeigte sonst
        # auf das Wirtssystem.
        for d, dirs, fs in os.walk(self.dir):
            for n in dirs + fs:
                q = os.path.join(d, n)
                if not os.path.islink(q):
                    os.chmod(q, 0o700 if n in dirs else 0o600)
        mf = os.path.join(self.dir, "manifest.toml")
        if not os.path.isfile(mf):
            raise Fehler(f"{path}: manifest.toml fehlt")
        with open(mf, "rb") as f:
            self.m = tomllib.load(f)
        if self.m.get("format") != 1:
            raise Fehler(f"{path}: unbekanntes Paketformat {self.m.get('format')}")
        if not NAME_RE.match(self.m.get("name", "")):
            raise Fehler(f"{path}: ungueltiger Paketname")
        self.verify_content()

    @property
    def name(self):
        return self.m["name"]

    def check_signature(self, keys):
        if not keys:
            return
        sig = self.path + ".sig"
        if not os.path.isfile(sig):
            raise Fehler(f"{self.path}: Signatur fehlt (Schluessel sind eingerichtet)")
        if not signature_ok(self.path, sig, keys):
            raise Fehler(f"{self.path}: Signatur ungueltig")

    def verify_manifest(self):
        """Prueft Aufbau und Werte des Manifests, bevor irgendetwas davon benutzt wird."""
        m = self.m
        for k in ("version", "release"):
            if not isinstance(m.get(k), (str, int)) or str(m[k]) == "":
                raise Fehler(f"{self.path}: Manifest ohne gueltige Angabe '{k}'")
        if not valid_deps(m.get("depends", [])):
            raise Fehler(f"{self.path}: Manifest: ungueltige Liste 'depends'")
        for k in ("provides", "conflicts", "groups"):
            v = m.get(k, [])
            if not isinstance(v, list) or not all(isinstance(x, str) and NAME_RE.match(x) for x in v):
                raise Fehler(f"{self.path}: Manifest: ungueltige Liste '{k}'")
        entries = m.get("file", [])
        if not isinstance(entries, list):
            raise Fehler(f"{self.path}: Manifest: 'file' ist keine Liste")
        seen = {}
        for e in entries:
            if not isinstance(e, dict) or not isinstance(e.get("path"), str):
                raise Fehler(f"{self.path}: Manifest: Dateieintrag ohne Pfad")
            rel = safe_rel(e["path"])
            if rel in seen:
                raise Fehler(f"{self.path}: /{rel} steht doppelt im Manifest")
            t = e.get("type")
            # Nur die leeren Grundverzeichnisse der Datenbank darf ein Paket mitbringen
            # (das Paket vpkg selbst), nichts darin.
            if (rel == DB or rel.startswith(DB + "/")) and not (
                    t == "dir" and rel in (DB, DB + "/installed")):
                raise Fehler(f"{self.path}: /{rel} liegt in der Paketdatenbank von VPKG")
            if t not in ("file", "dir", "symlink"):
                raise Fehler(f"{self.path}: /{rel}: unbekannter Typ {t!r}")
            if t in ("file", "dir") and not (isinstance(e.get("mode"), str) and MODE_RE.match(e["mode"])):
                raise Fehler(f"{self.path}: /{rel}: ungueltige Rechte {e.get('mode')!r}")
            if t == "file" and not (isinstance(e.get("sha256"), str) and SHA_RE.match(e["sha256"])):
                raise Fehler(f"{self.path}: /{rel}: ungueltige Pruefsumme")
            if t == "symlink" and not (isinstance(e.get("target"), str) and e["target"]
                                       and "\0" not in e["target"]):
                raise Fehler(f"{self.path}: /{rel}: Link ohne gueltiges Ziel")
            seen[rel] = t
        # Unter einer Datei oder einem Link kann nichts liegen (sonst wuerde ein Link aus dem
        # Paket als Weg in fremde Verzeichnisse dienen).
        for rel in seen:
            parent = os.path.dirname(rel)
            while parent:
                if seen.get(parent, "dir") != "dir":
                    raise Fehler(f"{self.path}: /{rel} liegt unter /{parent}, das kein Verzeichnis ist")
                parent = os.path.dirname(parent)

    def verify_content(self):
        self.verify_manifest()
        files = os.path.join(self.dir, "files")
        listed = set()
        for e in self.m.get("file", []):
            rel = safe_rel(e["path"])
            listed.add(rel)
            p = os.path.join(files, rel)
            t = e["type"]
            if t == "file":
                ok = os.path.isfile(p) and not os.path.islink(p) and sha256_file(p) == e["sha256"]
            elif t == "symlink":
                ok = os.path.islink(p) and os.readlink(p) == e["target"]
            elif t == "dir":
                ok = os.path.isdir(p) and not os.path.islink(p)
            else:
                ok = False
            if not ok:
                raise Fehler(f"{self.path}: /{rel} passt nicht zum Manifest")
        if os.path.isdir(files):
            for d, dirs, fs in os.walk(files):
                for n in dirs + fs:
                    rel = os.path.relpath(os.path.join(d, n), files)
                    if rel not in listed:
                        raise Fehler(f"{self.path}: /{rel} steht nicht im Manifest")
        inst = os.path.join(self.dir, "install")
        if "install_sha256" in self.m:
            if not os.path.isfile(inst) or sha256_file(inst) != self.m["install_sha256"]:
                raise Fehler(f"{self.path}: Install-Skript passt nicht zum Manifest")
        elif os.path.lexists(inst):
            raise Fehler(f"{self.path}: Install-Skript ohne Eintrag im Manifest")


def sh(s):
    return "'" + s.replace("'", "'\\''") + "'"


def safe_rel(path):
    rel = path.lstrip("/")
    parts = rel.split("/")
    if not rel or "\0" in rel or any(p in ("", ".", "..") for p in parts):
        raise Fehler(f"unsicherer Pfad im Paket: {path!r}")
    return rel


# ---------------------------------------------------------------- Datenbank

class System:
    def __init__(self, root, extra_keys=()):
        self.root = os.path.abspath(root)
        self.db = os.path.join(self.root, DB, "installed")
        self.keys = list(extra_keys)
        kd = os.path.join(self.root, KEYS)
        if os.path.isdir(kd):
            self.keys += sorted(os.path.join(kd, k) for k in os.listdir(kd) if k.endswith(".pem"))
        self._installed = None
        self.lockfd = None

    def lock(self):
        os.makedirs(self.db, exist_ok=True)
        self.lockfd = open(os.path.join(self.root, DB, "lock"), "w")
        try:
            fcntl.flock(self.lockfd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Fehler("ein anderer vpkg-Vorgang laeuft gerade")
        Txn(self).recover()

    @property
    def installed(self):
        if self._installed is None:
            self._installed = {}
            if os.path.isdir(self.db):
                for n in sorted(os.listdir(self.db)):
                    mf = os.path.join(self.db, n, "manifest.toml")
                    if os.path.isfile(mf):
                        with open(mf, "rb") as f:
                            self._installed[n] = tomllib.load(f)
        return self._installed

    def owners(self, exclude=()):
        """Pfad -> Paketname, fuer alle Dateien und Links (ohne Verzeichnisse)."""
        own = {}
        for n, m in self.installed.items():
            if n in exclude:
                continue
            for e in m.get("file", []):
                if e["type"] != "dir":
                    own[e["path"].lstrip("/")] = n
        return own

    def dir_owners(self, exclude=()):
        own = {}
        for n, m in self.installed.items():
            if n in exclude:
                continue
            for e in m.get("file", []):
                if e["type"] == "dir":
                    own.setdefault(e["path"].lstrip("/"), set()).add(n)
        return own

    def write_entry(self, pkg, txn):
        # Vorbereitet im Transaktionsverzeichnis: bei Abbruch raeumt rollback() es mit weg.
        tmp = os.path.join(txn.dir, f"neu-{pkg.name}")
        os.makedirs(tmp)
        shutil.copy(os.path.join(pkg.dir, "manifest.toml"), tmp)
        if os.path.isfile(os.path.join(pkg.dir, "install")):
            shutil.copy(os.path.join(pkg.dir, "install"), tmp)
        txn.db_put(pkg.name, tmp)
        self.installed[pkg.name] = pkg.m

    def drop_entry(self, name, txn):
        txn.db_put(name, None)
        self.installed.pop(name, None)

    def path(self, rel):
        return os.path.join(self.root, rel)

    def inside(self, p):
        """Pfad liegt (nach Aufloesen von Links) im Zielsystem?"""
        r = os.path.realpath(self.root)
        q = os.path.realpath(p)
        return r == "/" or q == r or q.startswith(r + "/")

    def run_in_root(self, argv, what):
        env = {"PATH": "/usr/bin:/usr/sbin", "HOME": "/root", "LC_ALL": "C", "TERM": "dumb"}
        if self.root == "/":
            cmd = argv
        elif os.geteuid() == 0:
            cmd = ["chroot", self.root] + argv
        else:
            raise Fehler(f"{what}: ausserhalb von / nur als root moeglich (oder --no-scripts)")
        r = subprocess.run(cmd, env=env)
        if r.returncode != 0:
            raise Fehler(f"{what} fehlgeschlagen (Rueckgabewert {r.returncode})")


# ---------------------------------------------------------------- Transaktionen

class Txn:
    """Journal fuer einen schreibenden Vorgang. Jede Aenderung wird vor der Ausfuehrung
    protokolliert (Zeile fuer Zeile, mit fsync); ersetzte und geloeschte Dateien bleiben bis
    zum Abschluss als Sicherung erhalten. rollback() nimmt alles in umgekehrter Reihenfolge
    zurueck, auch nach einem Absturz (recover())."""

    def __init__(self, system):
        self.s = system
        self.dir = system.path(TXN)
        self.journal = os.path.join(self.dir, "journal")
        self.f = None
        self.n = 0
        # Nur fuer Tests: "fehler:N" laesst die (N+1)-te Aenderung scheitern,
        # "absturz:N" beendet vpkg dort sofort (wie ein Stromausfall).
        self.test = os.environ.get("VPKG_TEST_ABBRUCH", "")

    # -- Ablauf

    def begin(self):
        if os.path.lexists(self.dir):
            raise Fehler(f"/{TXN} existiert noch (unterbrochener Vorgang?)")
        os.makedirs(os.path.join(self.dir, "sicherung"))
        self.f = open(self.journal, "x", encoding="utf-8")
        self._sync_dir(self.dir)
        return self

    def commit(self):
        self.f.close()
        os.unlink(self.journal)          # ab hier gilt der Vorgang als abgeschlossen
        self._sync_dir(self.dir)
        shutil.rmtree(self.dir)

    def rollback(self):
        if self.f:
            self.f.close()
            self.f = None
        recs = []
        with open(self.journal, encoding="utf-8") as f:
            for line in f:
                try:
                    recs.append(json.loads(line))
                except ValueError:
                    break                # unvollstaendige letzte Zeile (Abbruch beim Schreiben)
        problems = []
        for r in reversed(recs):
            try:
                self._undo(r)
            except OSError as e:
                problems.append(f"{r.get('op')} /{r.get('path', r.get('name', ''))}: {e}")
        self.s._installed = None
        if problems:
            raise Fehler("Zuruecknehmen unvollstaendig, Journal bleibt in /" + TXN + ":\n  "
                         + "\n  ".join(problems))
        shutil.rmtree(self.dir)
        return len(recs)

    def recover(self):
        if os.path.isfile(self.journal):
            warn(f"unterbrochener Vorgang in /{TXN} gefunden, wird zurueckgenommen")
            n = self.rollback()
            warn(f"{n} Aenderung(en) zurueckgenommen")
        elif os.path.lexists(self.dir):
            shutil.rmtree(self.dir)      # Abbruch nach dem Abschluss: nur Sicherungen uebrig

    # -- Aenderungen (jeweils erst protokollieren, dann ausfuehren)

    def put_file(self, rel, write_tmp):
        """Legt /rel an oder ersetzt es; write_tmp(tmp) erzeugt den neuen Inhalt."""
        dst = self.s.path(rel)
        tmp = os.path.join(os.path.dirname(dst), f".vpkg-{os.getpid()}-{os.path.basename(dst)}")
        rec = {"op": "put", "path": rel, "tmp": tmp, "backup": None}
        if os.path.lexists(dst):
            rec["backup"] = self._backup(dst)
        self._log(rec)
        if os.path.lexists(tmp):
            os.unlink(tmp)
        write_tmp(tmp)
        os.replace(tmp, dst)

    def mkdir(self, rel, mode):
        dst = self.s.path(rel)
        self._log({"op": "mkdir", "path": rel})
        os.mkdir(dst)
        os.chmod(dst, mode)

    def unlink(self, rel):
        dst = self.s.path(rel)
        self._log({"op": "unlink", "path": rel, "backup": self._backup(dst)})
        os.unlink(dst)

    def rename(self, rel, new_rel):
        self._log({"op": "rename", "path": rel, "to": new_rel})
        os.replace(self.s.path(rel), self.s.path(new_rel))

    def rmdir(self, rel):
        dst = self.s.path(rel)
        mode = os.stat(dst).st_mode & 0o7777
        self._log({"op": "rmdir", "path": rel, "mode": mode})
        os.rmdir(dst)

    def db_put(self, name, newdir):
        """Ersetzt (newdir) oder entfernt (None) den Datenbankeintrag eines Pakets."""
        d = os.path.join(self.s.db, name)
        rec = {"op": "db", "name": name, "backup": None}
        if os.path.lexists(d):
            rec["backup"] = os.path.join(self.dir, "sicherung", f"db-{name}")
        self._log(rec)
        if rec["backup"]:
            os.rename(d, rec["backup"])
        if newdir:
            os.rename(newdir, d)

    # -- intern

    def _log(self, rec):
        if self.test:
            art, _, n = self.test.partition(":")
            if self.n == int(n):
                if art == "absturz":
                    os._exit(70)
                raise OSError(5, f"Testabbruch nach {self.n} Aenderung(en)")
        self.n += 1
        self.f.write(json.dumps(rec, ensure_ascii=False) + "\n")
        self.f.flush()
        os.fsync(self.f.fileno())

    def _backup(self, dst):
        """Sichert eine Datei oder einen Link (fester Link, sonst Kopie) und liefert den Pfad."""
        b = os.path.join(self.dir, "sicherung", str(self.n))
        try:
            os.link(dst, b, follow_symlinks=False)
        except OSError:
            if os.path.islink(dst):
                os.symlink(os.readlink(dst), b)
            else:
                shutil.copy2(dst, b)
                st = os.stat(dst)
                if os.geteuid() == 0:
                    os.chown(b, st.st_uid, st.st_gid)
                os.chmod(b, st.st_mode & 0o7777)
        return b

    def _undo(self, r):
        op = r["op"]
        if op == "db":
            d = os.path.join(self.s.db, r["name"])
            if r["backup"] and os.path.lexists(r["backup"]):
                if os.path.lexists(d):
                    shutil.rmtree(d)
                os.rename(r["backup"], d)
            elif not r["backup"] and os.path.lexists(d):
                shutil.rmtree(d)
            return
        dst = self.s.path(r["path"])
        if op == "put":
            if os.path.lexists(r["tmp"]):
                os.unlink(r["tmp"])
            if r["backup"]:
                if os.path.lexists(r["backup"]):
                    os.replace(r["backup"], dst)
            elif os.path.lexists(dst) and not os.path.isdir(dst):
                os.unlink(dst)
        elif op == "mkdir":
            if os.path.isdir(dst) and not os.path.islink(dst):
                os.rmdir(dst)
        elif op == "unlink":
            if not os.path.lexists(dst) and os.path.lexists(r["backup"]):
                os.replace(r["backup"], dst)
        elif op == "rename":
            to = self.s.path(r["to"])
            if not os.path.lexists(dst) and os.path.lexists(to):
                os.replace(to, dst)
        elif op == "rmdir":
            if not os.path.lexists(dst):
                os.mkdir(dst)
                os.chmod(dst, r["mode"])

    @staticmethod
    def _sync_dir(d):
        fd = os.open(d, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)


def provides_map(pkgs):
    """Name -> Paketname fuer Namen und provides."""
    out = {}
    for n, m in pkgs.items():
        out.setdefault(n, n)
        for p in m.get("provides", []):
            out.setdefault(p, n)
    return out


# ---------------------------------------------------------------- Repository

MAX_META = 16 << 20        # Obergrenze fuer index.toml und Signaturen aus dem Netz
MAX_PAKET = 4 << 30        # Obergrenze fuer ein Paket aus dem Netz


class _NurHttps(urllib.request.HTTPRedirectHandler):
    """Folgt Umleitungen nur zu https: ein Spiegel darf nicht auf http umlenken."""
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if urllib.parse.urlparse(newurl).scheme != "https":
            raise Fehler(f"Umleitung auf eine Adresse ohne https abgelehnt: {newurl}")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


_OPENER = urllib.request.build_opener(_NurHttps)


def lies_index(label, idx, sig, keys):
    """Prueft Signatur und Aufbau eines Repository-Index; liefert (Pakete, Stand, signiert)."""
    signed = False
    if keys:
        if sig is None:
            raise Fehler(f"{label}: Repository-Index ist nicht signiert (index.toml.sig fehlt, "
                         "Schluessel sind eingerichtet)")
        if not signature_ok(idx, sig, keys):
            raise Fehler(f"{label}: Signatur des Repository-Index ungueltig")
        signed = True
    try:
        with open(idx, "rb") as f:
            data = tomllib.load(f)
    except (tomllib.TOMLDecodeError, UnicodeDecodeError) as e:
        raise Fehler(f"{label}: Repository-Index nicht lesbar ({e})")
    pkgs = Repo.check_index(label, data)
    stand = data.get("stand")
    if signed and stand is None:
        raise Fehler(f"{label}: signierter Repository-Index ohne Stand (stand = ...)")
    return pkgs, stand, signed


def schreibe_atomar(src, ziel):
    """Kopiert src nach ziel, ohne dass je eine halbe Datei unter dem Namen ziel liegt."""
    os.makedirs(os.path.dirname(ziel), exist_ok=True)
    teil = ziel + ".teil"
    shutil.copyfile(src, teil)
    os.replace(teil, ziel)


class Repo:
    def __init__(self, src, tmp, system=None, stand_key=None, cache=None):
        self.src = src.rstrip("/")
        self.stand_key = stand_key or self.src
        self.cache = cache
        scheme = urllib.parse.urlparse(self.src).scheme
        if scheme == "http":
            raise Fehler(f"{self.src}: Repositories im Netz nur ueber https (Index und Pakete sind "
                         "zwar signiert, aber ohne https sieht jeder mit, was installiert wird)")
        if scheme not in ("", "https"):
            raise Fehler(f"{self.src}: unbekannte Repository-Adresse (erlaubt: Verzeichnis oder https)")
        self.remote = scheme == "https"
        self.tmp = tempfile.mkdtemp(dir=tmp)
        keys = system.keys if system else []
        self.idx = self.fetch("index.toml")
        self.sig = self.fetch("index.toml.sig", optional=True) if keys else None
        self.pkgs, self.stand, self.signed = lies_index(self.src, self.idx, self.sig, keys)
        if system is not None and self.stand is not None:
            self.check_stand(system)

    @staticmethod
    def check_index(label, data):
        """Prueft Aufbau und Werte des Index, bevor etwas daraus benutzt wird."""
        if data.get("format") != 1:
            raise Fehler(f"{label}: unbekanntes Index-Format {data.get('format')!r}")
        st = data.get("stand")
        if st is not None and (not isinstance(st, int) or isinstance(st, bool) or st < 0):
            raise Fehler(f"{label}: ungueltiger Index-Stand {st!r}")
        entries = data.get("package", [])
        if not isinstance(entries, list):
            raise Fehler(f"{label}: Index: 'package' ist keine Liste")
        pkgs = {}
        for e in entries:
            if not isinstance(e, dict):
                raise Fehler(f"{label}: Index: ungueltiger Eintrag")
            n = e.get("name")
            if not isinstance(n, str) or not NAME_RE.match(n):
                raise Fehler(f"{label}: Index: ungueltiger Paketname {n!r}")
            if n in pkgs:
                raise Fehler(f"{label}: Index: {n} steht doppelt drin")
            fn = e.get("filename")
            if not isinstance(fn, str) or not FILENAME_RE.match(fn):
                raise Fehler(f"{label}: Index: {n}: ungueltiger Dateiname {fn!r}")
            if not isinstance(e.get("sha256"), str) or not SHA_RE.match(e["sha256"]):
                raise Fehler(f"{label}: Index: {n}: ungueltige Pruefsumme")
            for k in ("version", "release"):
                if not isinstance(e.get(k), (str, int)) or str(e[k]) == "":
                    raise Fehler(f"{label}: Index: {n}: Angabe '{k}' fehlt")
            if not valid_deps(e.get("depends", [])):
                raise Fehler(f"{label}: Index: {n}: ungueltige Liste 'depends'")
            for k in ("provides", "conflicts", "groups"):
                v = e.get(k, [])
                if not isinstance(v, list) or not all(isinstance(x, str) and NAME_RE.match(x) for x in v):
                    raise Fehler(f"{label}: Index: {n}: ungueltige Liste '{k}'")
            pkgs[n] = e
        return pkgs

    def check_stand(self, system):
        """Der Stand eines signierten Index darf nicht zuruecklaufen (Schutz gegen alte Kopien)."""
        f = system.path(REPO_STAND)
        try:
            with open(f, encoding="utf-8") as fh:
                seen = json.load(fh)
            if not isinstance(seen, dict):
                seen = {}
        except FileNotFoundError:
            seen = {}
        except ValueError:
            raise Fehler(f"/{REPO_STAND} ist beschaedigt (bitte pruefen)")
        old = seen.get(self.stand_key)
        if isinstance(old, int) and self.stand < old:
            raise Fehler(f"{self.src}: Repository-Index ist aelter als der zuletzt angenommene "
                         f"(Stand {self.stand} < {old}); veraltete oder zurueckgespielte Kopie?")
        if self.signed and (old is None or self.stand > old):
            # Nur signierte Staende merken: sonst koennte ein unsignierter Index mit riesigem
            # Stand kuenftige Aktualisierungen blockieren.
            seen[self.stand_key] = self.stand
            tmp = f + ".neu"
            with open(tmp, "w", encoding="utf-8") as fh:
                json.dump(seen, fh, indent=1, sort_keys=True)
                fh.flush()
                os.fsync(fh.fileno())
            os.replace(tmp, f)

    def fetch(self, name, optional=False):
        if not self.remote:
            p = os.path.join(self.src, name)
            if not os.path.isfile(p):
                if optional:
                    return None
                raise Fehler(f"im Repository fehlt {name}")
            return p
        out = os.path.join(self.tmp, "dl-" + name)
        return download(self.src, name, out, optional)

    def get(self, name, spiegel=()):
        """Paketdatei zum Index-Eintrag name; bei Netz-Quellen ueber den Cache. Scheitert der
        Download, kommen die weiteren Spiegel dran (die Pruefsumme stammt aus dem Index)."""
        e = self.pkgs[name]
        fn = e["filename"]
        if not self.remote or not self.cache:
            path = self.fetch(fn)
            if sha256_file(path) != e["sha256"]:
                raise Fehler(f"{fn}: SHA-256 passt nicht zum Repository-Index")
            sig = self.fetch(fn + ".sig", optional=True)
            if sig and self.remote:
                os.replace(sig, path + ".sig")
            return path
        os.makedirs(self.cache, exist_ok=True)
        ziel = os.path.join(self.cache, fn)
        if os.path.isfile(ziel):
            if sha256_file(ziel) == e["sha256"]:
                info(f"   {fn} aus dem Cache")
            else:
                warn(f"{fn} im Cache passt nicht zum Index, wird neu geladen")
                os.unlink(ziel)
                if os.path.exists(ziel + ".sig"):
                    os.unlink(ziel + ".sig")
        fehler = []
        for base in [self.src, *[m for m in spiegel if m.rstrip("/") != self.src]]:
            base = base.rstrip("/")
            if not os.path.isfile(ziel):
                teil = ziel + ".teil"
                try:
                    download(base, fn, teil)
                except Fehler as ex:
                    if os.path.exists(teil):
                        os.unlink(teil)
                    fehler.append(str(ex))
                    continue
                if sha256_file(teil) != e["sha256"]:
                    os.unlink(teil)
                    fehler.append(f"{fn}: SHA-256 passt nicht zum Repository-Index ({base})")
                    continue
                os.replace(teil, ziel)
            if not os.path.isfile(ziel + ".sig"):
                teil = ziel + ".sig.teil"
                try:
                    if download(base, fn + ".sig", teil, optional=True):
                        os.replace(teil, ziel + ".sig")
                except Fehler as ex:
                    if os.path.exists(teil):
                        os.unlink(teil)
                    fehler.append(str(ex))
                    continue
            return ziel
        raise Fehler("; ".join(fehler))


def download(base, name, out, optional=False):
    """Laedt base/name nach out (nur https, mit Groessengrenze). Bei Fehlern bleibt out
    unvollstaendig liegen; der Aufrufer entscheidet, was damit geschieht."""
    grenze = MAX_PAKET if name.endswith(".vpkg") else MAX_META
    try:
        with _OPENER.open(f"{base}/{urllib.parse.quote(name)}", timeout=60) as r, \
                open(out, "wb") as f:
            n = 0
            while True:
                block = r.read(1 << 20)
                if not block:
                    break
                n += len(block)
                if n > grenze:
                    raise Fehler(f"{name} ist groesser als erlaubt ({grenze >> 20} MiB)")
                f.write(block)
            laenge = r.headers.get("Content-Length")
            if laenge is not None and laenge.isdigit() and int(laenge) != n:
                raise Fehler(f"unvollstaendig ({n} von {laenge} Bytes)")
    except Fehler as e:
        raise Fehler(f"Download abgelehnt: {name}: {e}")
    except Exception as e:  # noqa: BLE001 - jede Netzwerkursache gleich melden
        if optional and isinstance(e, urllib.error.HTTPError) and e.code == 404:
            return None
        raise Fehler(f"Download fehlgeschlagen: {name} ({e})")
    return out


class Quelle:
    """Eine eingerichtete Quelle mit Namen und Spiegeln. Der erste Spiegel, dessen Index die
    Pruefung besteht (Signatur, Stand nicht aelter als zuletzt angenommen), gilt; Pakete kommen
    in den Cache und notfalls von den anderen Spiegeln."""

    def __init__(self, name, mirrors, tmp, system, stand_key=None):
        self.name, self.mirrors = name, mirrors
        self.repo = None
        fehler = []
        for m in mirrors:
            try:
                self.repo = Repo(m, tmp, system, stand_key=stand_key or f"quelle:{name}",
                                 cache=system.path(CACHE + "/pakete"))
                break
            except Fehler as e:
                warn(f"{name}: Spiegel {m} uebersprungen: {e}")
                fehler.append(str(e))
        if self.repo is None:
            raise Fehler(f"Quelle {name}: kein Spiegel brauchbar")
        self.pkgs = self.repo.pkgs
        # Den geprueften Index fuer search und repo list aufheben.
        d = system.path(f"{CACHE}/index/{name}")
        schreibe_atomar(self.repo.idx, os.path.join(d, "index.toml"))
        if self.repo.sig:
            schreibe_atomar(self.repo.sig, os.path.join(d, "index.toml.sig"))
        elif os.path.exists(os.path.join(d, "index.toml.sig")):
            os.unlink(os.path.join(d, "index.toml.sig"))

    def get(self, n):
        return self.repo.get(n, self.mirrors)


class Quellen:
    """Mehrere Quellen zusammen: bei gleichem Paketnamen gilt die zuerst eingerichtete."""

    def __init__(self, quellen):
        self.quellen = quellen
        self.pkgs, self.herkunft = {}, {}
        for q in quellen:
            for n, e in q.pkgs.items():
                if n not in self.pkgs:
                    self.pkgs[n], self.herkunft[n] = e, q

    def get(self, n):
        return self.herkunft[n].get(n)


class LazyRepo:
    """Laedt (und prueft) den Repository-Index erst, wenn er gebraucht wird: eine lokale
    Paketdatei ohne fehlende Abhaengigkeiten kommt ohne Repository aus."""

    def __init__(self, make):
        self._make = make
        self._repo = None

    def __getattr__(self, name):
        if self._repo is None:
            self._repo = self._make()
        return getattr(self._repo, name)


def eingerichtete_quellen(system):
    """[(Name, [Spiegel...], Stand-Schluessel)] aus repos.d, sonst aus etc/vpkg/repo."""
    d = system.path(REPOS_D)
    out = []
    if os.path.isdir(d):
        for fn in sorted(os.listdir(d)):
            if not fn.endswith(".conf"):
                continue
            pfad = os.path.join(d, fn)
            try:
                with open(pfad, "rb") as f:
                    c = tomllib.load(f)
            except (tomllib.TOMLDecodeError, UnicodeDecodeError) as e:
                raise Fehler(f"/{REPOS_D}/{fn} nicht lesbar ({e})")
            name, mirrors = c.get("name"), c.get("mirrors")
            if not isinstance(name, str) or not NAME_RE.match(name):
                raise Fehler(f"/{REPOS_D}/{fn}: ungueltiger Name {name!r}")
            if not isinstance(mirrors, list) or not mirrors or \
                    not all(isinstance(m, str) and m for m in mirrors):
                raise Fehler(f"/{REPOS_D}/{fn}: 'mirrors' muss eine nicht leere Liste von Adressen sein")
            if any(n == name for n, _, _ in out):
                raise Fehler(f"/{REPOS_D}/{fn}: Quelle {name} ist doppelt eingerichtet")
            out.append((name, mirrors, None))
    if out:
        return out
    f = system.path(REPO_FILE)
    if os.path.isfile(f):
        for line in open(f):
            line = line.strip()
            if line and not line.startswith("#"):
                # Alte Einrichtung: Stand weiter unter der Adresse merken (wie bis 0.5).
                return [("standard", [line], line.rstrip("/"))]
    return []


def repo_fuer(args, system, tmp):
    """Repository fuer install/upgrade: --repo QUELLE oder alle eingerichteten Quellen."""
    if args.repo:
        return LazyRepo(lambda: Repo(args.repo, tmp, system))
    qs = eingerichtete_quellen(system)
    if not qs:
        return None
    return LazyRepo(lambda: Quellen([Quelle(n, m, tmp, system, k) for n, m, k in qs]))


def gruppen_aufloesen(wanted, repo):
    out = []
    for w in wanted:
        if not w.startswith("@"):
            out.append(w)
            continue
        if repo is None:
            raise Fehler(f"{w}: Gruppen gibt es nur mit Repository (--repo oder /{REPOS_D})")
        mitglieder = sorted(n for n, e in repo.pkgs.items() if w[1:] in e.get("groups", []))
        if not mitglieder:
            raise Fehler(f"{w}: keine Pakete mit dieser Gruppe im Repository")
        info(f"{w}: {', '.join(mitglieder)}")
        out.extend(m for m in mitglieder if m not in out)
    return out


def cmd_update(args, system):
    qs = eingerichtete_quellen(system)
    if not qs:
        raise Fehler(f"keine Quelle eingerichtet (/{REPOS_D}/*.conf oder /{REPO_FILE})")
    system.lock()
    with tempfile.TemporaryDirectory(prefix="vpkg.") as tmp:
        for n, m, k in qs:
            q = Quelle(n, m, tmp, system, k)
            info(f"{n}: {len(q.pkgs)} Pakete, Stand {q.repo.stand}, von {q.repo.src}")
    return 0


def zwischengespeicherte(system):
    """[(Name, Spiegel, Pakete, Stand)] aus dem Cache; jeder Index wird erneut geprueft."""
    out = []
    for n, m, _ in eingerichtete_quellen(system):
        d = system.path(f"{CACHE}/index/{n}")
        idx = os.path.join(d, "index.toml")
        if not os.path.isfile(idx):
            out.append((n, m, None, None))
            continue
        sig = os.path.join(d, "index.toml.sig")
        pkgs, stand, _ = lies_index(f"Cache {n}", idx, sig if os.path.isfile(sig) else None,
                                    system.keys)
        out.append((n, m, pkgs, stand))
    return out


def cmd_search(args, system):
    muster = args.muster.lower()
    qs = zwischengespeicherte(system)
    if not qs or all(p is None for _, _, p, _ in qs):
        raise Fehler("kein Paketindex im Cache (erst vpkg update)")
    gefunden = 0
    for n, _, pkgs, _ in qs:
        for name, e in sorted((pkgs or {}).items()):
            text = " ".join([name, str(e.get("description", "")), *e.get("groups", [])]).lower()
            if muster in text:
                gefunden += 1
                inst = system.installed.get(name)
                mark = f" [installiert {fullver(inst)}]" if inst else ""
                gr = f" (@{', @'.join(e['groups'])})" if e.get("groups") else ""
                print(f"{n}/{name} {fullver(e)}{mark}{gr}\n    {e.get('description', '')}")
    if not gefunden:
        info(f"Nichts gefunden: {args.muster}")
        return 1
    return 0


def cmd_clean(args, system):
    system.lock()
    frei = 0
    dirs = [system.path(CACHE + "/pakete")] + ([system.path(CACHE + "/index")] if args.alles else [])
    for d in dirs:
        if not os.path.isdir(d):
            continue
        for wurzel, _, fs in os.walk(d):
            frei += sum(os.lstat(os.path.join(wurzel, f)).st_size for f in fs)
        shutil.rmtree(d)
    info(f"Cache geleert ({frei >> 10} KiB frei)")
    return 0


def cmd_repo(args, system):
    qs = zwischengespeicherte(system)
    if not qs:
        info(f"keine Quelle eingerichtet (/{REPOS_D}/*.conf oder /{REPO_FILE})")
        return 0
    for n, m, pkgs, stand in qs:
        stand_txt = f"Stand {stand}, {len(pkgs)} Pakete" if pkgs is not None else "noch kein vpkg update"
        print(f"{n}: {stand_txt}")
        for x in m:
            print(f"    {x}")
    return 0


def cmd_index(args):
    d = args.dir
    stand = args.stand
    if stand is None:
        stand = int(os.environ.get("SOURCE_DATE_EPOCH") or time.time())
    if stand < 0:
        raise Fehler("--stand muss >= 0 sein")
    entries = []
    for fn in sorted(os.listdir(d)):
        if not fn.endswith(".vpkg"):
            continue
        with tempfile.TemporaryDirectory() as tmp:
            pkg = Paket(os.path.join(d, fn), tmp, [])
            m = pkg.m
            entries.append((m, fn, sha256_file(os.path.join(d, fn))))
    names = [m["name"] for m, _, _ in entries]
    dup = {n for n in names if names.count(n) > 1}
    if dup:
        raise Fehler("mehrere Versionen im selben Repository: " + ", ".join(sorted(dup)))
    with open(os.path.join(d, "index.toml.neu"), "w") as f:
        f.write("# VPKG-Repository-Index (erzeugt von vpkg index)\nformat = 1\n")
        f.write(f"stand = {stand}\n")
        for m, fn, sha in entries:
            f.write("\n[[package]]\n")
            f.write(f"name = {toml_str(m['name'])}\n")
            f.write(f"version = {toml_str(m['version'])}\n")
            f.write(f"release = {m.get('release', 1)}\n")
            f.write(f"description = {toml_str(m.get('description', ''))}\n")
            for k in ("depends", "provides", "conflicts"):
                f.write(f"{k} = [{', '.join(toml_str(x) for x in m.get(k, []))}]\n")
            if m.get("groups"):
                f.write(f"groups = [{', '.join(toml_str(x) for x in m['groups'])}]\n")
            f.write(f"filename = {toml_str(fn)}\nsha256 = {toml_str(sha)}\n")
    os.replace(os.path.join(d, "index.toml.neu"), os.path.join(d, "index.toml"))
    info(f"index.toml: {len(entries)} Pakete")


# ---------------------------------------------------------------- Installieren

def resolve(system, wanted, repo, tmp, no_deps):
    """Liefert die zu installierenden Pakete (Paket-Objekte), Abhaengigkeiten zuerst."""
    chosen = {}          # Name -> Paket

    def load(path, from_repo=None):
        p = Paket(path, tmp, system.keys)
        if from_repo is not None:
            # Das Paket muss genau das sein, was der (signierte) Index verspricht.
            e = repo.pkgs[from_repo]
            if p.name != from_repo or fullver(p.m) != fullver(e) \
                    or p.m.get("depends", []) != e.get("depends", []):
                raise Fehler(f"{e['filename']}: Paket passt nicht zum Repository-Index "
                             f"({p.name} {fullver(p.m)} statt {from_repo} {fullver(e)})")
        if p.name in chosen:
            raise Fehler(f"{p.name} ist doppelt angegeben")
        chosen[p.name] = p

    for w in wanted:
        if w.endswith(".vpkg") or os.sep in w:
            if not os.path.isfile(w):
                raise Fehler(f"Datei nicht gefunden: {w}")
            load(os.path.abspath(w))
        else:
            if repo is None:
                raise Fehler(f"{w}: kein Repository angegeben (--repo, /{REPOS_D} oder /{REPO_FILE})")
            if w not in repo.pkgs:
                raise Fehler(f"{w}: nicht im Repository")
            load(repo.get(w), w)

    # Fehlende oder zu alte Abhaengigkeiten aus dem Repository nachladen.
    while True:
        pool = {**system.installed, **{n: p.m for n, p in chosen.items()}}
        pmap = provides_map(pool)
        missing = sorted({d for p in chosen.values() for d in p.m.get("depends", [])
                          if not satisfied(d, pool, pmap)})
        if not missing or no_deps:
            break
        repo_pkgs = repo.pkgs if repo else {}
        repo_have = provides_map(repo_pkgs)
        load_now, unresolved = set(), []
        for d in missing:
            n, op, ver = parse_dep(d)
            if op is None:
                cand = repo_have.get(n)
            else:
                cand = n if n in repo_pkgs and ver_ok(repo_pkgs[n], op, ver) else None
            if cand is None or cand in chosen:
                wer = sorted(p.name for p in chosen.values() if d in p.m.get("depends", []))
                hat = f", vorhanden: {n} {fullver(pool[n])}" if n in pool else ""
                unresolved.append(f"{d} (fuer {', '.join(wer)}{hat})")
            else:
                load_now.add(cand)
        if unresolved:
            raise Fehler("Abhaengigkeiten nicht erfuellbar: " + "; ".join(unresolved))
        for n in sorted(load_now):
            info(f"   + {n} {fullver(repo_pkgs[n])} (Abhaengigkeit)")
            load(repo.get(n), n)

    # Bedingungen schon installierter Pakete duerfen durch diese Installation nicht
    # brechen (z. B. Downgrade einer Bibliothek, die ein anderes Paket in neuer Version braucht).
    if not no_deps:
        pool = {**system.installed, **{n: p.m for n, p in chosen.items()}}
        pmap = provides_map(pool)
        broken = [f"{n} braucht {d}" for n, m in sorted(pool.items()) if n not in chosen
                  for d in m.get("depends", [])
                  if dep_name(d) in chosen and not satisfied(d, pool, pmap)]
        if broken:
            raise Fehler("die Installation wuerde Abhaengigkeiten brechen:\n  " + "\n  ".join(broken))

    # Konflikte
    after = {**system.installed, **{n: p.m for n, p in chosen.items()}}
    for n, m in after.items():
        for c in m.get("conflicts", []):
            other = provides_map({k: v for k, v in after.items() if k != n}).get(c)
            if other and (n in chosen or other in chosen):
                raise Fehler(f"{n} steht im Konflikt mit {other}")

    # Reihenfolge: Abhaengigkeiten zuerst (innerhalb dieser Installation).
    have = provides_map({n: p.m for n, p in chosen.items()})
    order, state = [], {}

    def visit(n):
        if state.get(n) == 2:
            return
        if state.get(n) == 1:
            return  # Kreis: Reihenfolge innerhalb des Kreises ist egal
        state[n] = 1
        for d in chosen[n].m.get("depends", []):
            if dep_name(d) in have:
                visit(have[dep_name(d)])
        state[n] = 2
        order.append(chosen[n])

    for n in sorted(chosen):
        visit(n)
    return order


def file_conflicts(system, pkgs, overwrite):
    names = {p.name for p in pkgs}
    owners = system.owners(exclude=names)
    claimed = {}
    problems = []
    for p in pkgs:
        old = {e["path"].lstrip("/") for e in system.installed.get(p.name, {}).get("file", [])
               if e["type"] != "dir"}
        for e in p.m.get("file", []):
            rel = e["path"].lstrip("/")
            dst = system.path(rel)
            if e["type"] == "dir":
                if os.path.lexists(dst) and not os.path.isdir(dst):
                    problems.append(f"/{rel} ist im System kein Verzeichnis ({p.name})")
                continue
            if rel in claimed:
                problems.append(f"/{rel} kommt in {claimed[rel]} und {p.name} vor")
            claimed[rel] = p.name
            if rel in owners:
                if not overwrite:
                    problems.append(f"/{rel} gehoert schon zu {owners[rel]} ({p.name})")
            elif os.path.lexists(dst) and rel not in old:
                if os.path.isdir(dst) and not os.path.islink(dst):
                    problems.append(f"/{rel} ist im System ein Verzeichnis ({p.name})")
                elif not overwrite:
                    problems.append(f"/{rel} existiert schon und gehoert keinem Paket ({p.name})")
    if problems:
        raise Fehler("Dateikonflikte:\n  " + "\n  ".join(problems[:30])
                     + ("\n  ..." if len(problems) > 30 else "")
                     + "\n(--overwrite ueberschreibt sie)")


def is_config(rel):
    return rel.startswith("etc/")


def place(system, pkg, txn):
    """Kopiert die Dateien eines Pakets ins System; liefert die Pfade der alten Version,
    die in der neuen fehlen."""
    old = system.installed.get(pkg.name)
    old_files = {e["path"].lstrip("/"): e for e in old.get("file", [])} if old else {}
    src_root = os.path.join(pkg.dir, "files")
    new_paths = set()
    for e in pkg.m.get("file", []):
        rel = safe_rel(e["path"])
        new_paths.add(rel)
        dst = system.path(rel)
        if not system.inside(os.path.dirname(dst)):
            raise Fehler(f"/{rel}: Zielverzeichnis zeigt aus dem System heraus")
        t = e["type"]
        if t == "dir":
            if not os.path.lexists(dst):
                txn.mkdir(rel, int(e["mode"], 8))
            continue
        src = os.path.join(src_root, rel)
        if t == "file" and is_config(rel) and os.path.isfile(dst) and not os.path.islink(dst):
            cur = sha256_file(dst)
            prev = old_files.get(rel, {}).get("sha256")
            if cur != e["sha256"] and prev is not None and cur != prev:
                # Vom Nutzer geaenderte Konfiguration bleibt; die neue kommt daneben.
                txn.put_file(rel + ".vpkgnew", copier(src, int(e["mode"], 8)))
                warn(f"/{rel} wurde geaendert und bleibt; neue Fassung: /{rel}.vpkgnew")
                continue
        if t == "file":
            txn.put_file(rel, copier(src, int(e["mode"], 8)))
        else:
            txn.put_file(rel, lambda tmp, target=e["target"]: os.symlink(target, tmp))
    return [p for p, e in old_files.items() if p not in new_paths]


def copier(src, mode):
    def write(tmp):
        shutil.copyfile(src, tmp)
        os.chmod(tmp, mode)
    return write


def remove_paths(system, name, paths, txn, keep_owned_by_others=True):
    """Entfernt Dateien/Links; leere Verzeichnisse danach nur, wenn sie niemand sonst nutzt."""
    owners = system.owners(exclude={name})
    downers = system.dir_owners(exclude={name})
    entries = {e["path"].lstrip("/"): e for e in system.installed[name].get("file", [])}
    dirs = []
    for rel in paths:
        e = entries.get(rel)
        if e is None:
            continue
        if e["type"] == "dir":
            dirs.append(rel)
            continue
        if keep_owned_by_others and rel in owners:
            continue
        dst = system.path(rel)
        if not os.path.lexists(dst):
            continue
        if e["type"] == "file" and is_config(rel) and not os.path.islink(dst) \
                and os.path.isfile(dst) and sha256_file(dst) != e["sha256"]:
            txn.rename(rel, rel + ".vpkgsave")
            warn(f"/{rel} war geaendert und bleibt als /{rel}.vpkgsave")
            continue
        if os.path.isdir(dst) and not os.path.islink(dst):
            continue
        txn.unlink(rel)
    for rel in sorted(dirs, reverse=True):
        if rel in downers:
            continue
        dst = system.path(rel)
        # Nur leere Verzeichnisse; eines mit fremden oder neuen Dateien bleibt.
        if os.path.isdir(dst) and not os.path.islink(dst) and not os.listdir(dst):
            txn.rmdir(rel)


def ldconfig(system):
    if system.root == "/":
        subprocess.run(["ldconfig"], check=False)
    elif os.geteuid() == 0 and os.path.exists(system.path("usr/sbin/ldconfig")):
        subprocess.run(["chroot", system.root, "/usr/sbin/ldconfig"], check=False)


SKRIPT_FEHLER = "skript-fehler"   # im Datenbankeintrag: post_install ist gescheitert


def has_script_function(system, name, func):
    inst = system.path(f"{DB}/installed/{name}/install")
    if not os.path.isfile(inst):
        return False
    with open(inst, errors="replace") as f:
        return any(z.startswith(f"{func} ()") for z in f)


def run_install_script(system, name):
    """Fuehrt post_install aus. Scheitert es, bleibt das Paket installiert, aber im
    Datenbankeintrag steht ein Vermerk, den vpkg check meldet, bis ein neuer Lauf gelingt."""
    vermerk = system.path(f"{DB}/installed/{name}/{SKRIPT_FEHLER}")
    if not has_script_function(system, name, "post_install"):
        return
    info(f"   Install-Skript von {name}")
    inst = f"/{DB}/installed/{name}/install"
    try:
        system.run_in_root(["/bin/bash", "-c", 'set -e; . "$1"; post_install', "vpkg", inst],
                           f"Install-Skript von {name}")
    except Fehler as e:
        with open(vermerk, "w") as f:
            f.write(f"{e}\n")
        raise
    if os.path.exists(vermerk):
        os.remove(vermerk)


def run_pre_remove(system, name):
    """Fuehrt pre_remove aus (vor dem Entfernen); scheitert es, wird nichts entfernt."""
    if not has_script_function(system, name, "pre_remove"):
        return
    info(f"   Entfern-Skript von {name}")
    inst = f"/{DB}/installed/{name}/install"
    system.run_in_root(["/bin/bash", "-c", 'set -e; . "$1"; pre_remove', "vpkg", inst],
                       f"Entfern-Skript (pre_remove) von {name}")


def cmd_install(args, system, upgrade_only=False):
    system.lock()
    with tempfile.TemporaryDirectory(prefix="vpkg.") as tmp:
        repo = repo_fuer(args, system, tmp)
        wanted = gruppen_aufloesen(args.packages, repo)
        if upgrade_only:
            if repo is None:
                raise Fehler(f"upgrade braucht ein Repository (--repo, /{REPOS_D} oder /{REPO_FILE})")
            wanted = [n for n, m in system.installed.items()
                      if n in repo.pkgs and vercmp(fullver(repo.pkgs[n]), fullver(m)) > 0]
            if not wanted:
                info("Alles aktuell.")
                return 0
        pkgs = resolve(system, wanted, repo, tmp, args.no_deps)
        if not args.allow_downgrade:
            for p in pkgs:
                old = system.installed.get(p.name)
                if old is not None and vercmp(fullver(p.m), fullver(old)) < 0:
                    raise Fehler(f"{p.name}: {fullver(p.m)} ist aelter als die installierte Version "
                                 f"{fullver(old)} (absichtlich zurueckstufen: --allow-downgrade)")
        file_conflicts(system, pkgs, args.overwrite)

        def apply(txn):
            for p in pkgs:
                old = system.installed.get(p.name)
                if old is None:
                    what = f"installiere {p.name} {fullver(p.m)}"
                else:
                    c = vercmp(fullver(p.m), fullver(old))
                    what = {1: "aktualisiere", 0: "installiere neu", -1: "stufe zurueck"}[c]
                    what = f"{what} {p.name} {fullver(old)} -> {fullver(p.m)}"
                info(f">> {what}")
                stale = place(system, p, txn)
                if old is not None:
                    remove_paths(system, p.name, stale, txn)
                system.write_entry(p, txn)
        transaction(system, "Installation", apply)
        ldconfig(system)
        if not args.no_scripts:
            for p in pkgs:
                try:
                    run_install_script(system, p.name)
                except Fehler as e:
                    raise Fehler(f"{e}\nDas Paket {p.name} ist installiert, sein Install-Skript aber "
                                 "nicht durchgelaufen (vpkg check meldet das). Ein Install-Skript "
                                 f"laesst sich nicht zuruecknehmen; erneut ausfuehren: vpkg rerun-script "
                                 f"{p.name}")
        info(f"Fertig: {len(pkgs)} Paket(e).")
    return 0


def transaction(system, what, apply):
    """Fuehrt apply(txn) als Ganzes aus: bei jedem Fehler wird alles zurueckgenommen."""
    txn = Txn(system).begin()
    try:
        apply(txn)
    except BaseException as e:
        grund = e if isinstance(e, (Fehler, OSError)) else type(e).__name__
        try:
            n = txn.rollback()
        except Fehler as r:
            raise Fehler(f"{what} abgebrochen ({grund}).\n{r}") from e
        raise Fehler(f"{what} abgebrochen ({grund}); {n} Aenderung(en) zurueckgenommen, "
                     "das System ist unveraendert") from e
    txn.commit()


# ---------------------------------------------------------------- Entfernen

def cmd_remove(args, system):
    system.lock()
    names = []
    for n in args.names:
        if n not in system.installed:
            raise Fehler(f"{n} ist nicht installiert")
        names.append(n)
    if not args.no_deps:
        rest = {n: m for n, m in system.installed.items() if n not in names}
        have = provides_map(rest)
        needed = []
        for n, m in rest.items():
            for d in m.get("depends", []):
                if not satisfied(d, rest, have):
                    needed.append(f"{n} braucht {d}")
        if needed:
            raise Fehler("wird noch gebraucht:\n  " + "\n  ".join(sorted(needed))
                         + "\n(--no-deps entfernt trotzdem)")
    if not args.no_scripts:
        # Vor jeder Aenderung: scheitert ein pre_remove, bleibt alles, wie es ist.
        for n in names:
            try:
                run_pre_remove(system, n)
            except Fehler as e:
                raise Fehler(f"{e}\nNichts entfernt (ohne Skript: vpkg remove --no-scripts {n})")

    def apply(txn):
        for n in names:
            info(f">> entferne {n} {fullver(system.installed[n])}")
            paths = [e["path"].lstrip("/") for e in system.installed[n].get("file", [])]
            remove_paths(system, n, paths, txn)
            system.drop_entry(n, txn)
    transaction(system, "Entfernen", apply)
    ldconfig(system)
    info(f"Fertig: {len(names)} Paket(e) entfernt.")
    return 0


# ---------------------------------------------------------------- Abfragen

def cmd_list(args, system):
    for n, m in system.installed.items():
        print(f"{n} {fullver(m)}")
    return 0


def need(system, name):
    if name not in system.installed:
        raise Fehler(f"{name} ist nicht installiert")
    return system.installed[name]


def cmd_info(args, system):
    m = need(system, args.name)
    rdeps = sorted(n for n, o in system.installed.items()
                   if any(provides_map({args.name: m}).get(dep_name(d)) for d in o.get("depends", [])))
    rows = [("Name", m["name"]), ("Version", fullver(m)), ("Beschreibung", m.get("description", "")),
            ("Lizenz", m.get("license", "")), ("Adresse", m.get("url", "")),
            ("Haengt ab von", ", ".join(m.get("depends", [])) or "-"),
            ("Stellt bereit", ", ".join(m.get("provides", [])) or "-"),
            ("Konflikte", ", ".join(m.get("conflicts", [])) or "-"),
            ("Gruppen", ", ".join(m.get("groups", [])) or "-"),
            ("Gebraucht von", ", ".join(rdeps) or "-"),
            ("Dateien", str(sum(1 for e in m.get("file", []) if e["type"] != "dir"))),
            ("Install-Skript", "ja" if "install_sha256" in m else "nein"),
            ("Rezept-SHA-256", m.get("recipe_sha256", ""))]
    for k, v in rows:
        print(f"{k:<16}: {v}")
    return 0


def cmd_files(args, system):
    for e in need(system, args.name).get("file", []):
        print(e["path"] + ("/" if e["type"] == "dir" else ""))
    return 0


def cmd_owner(args, system):
    p = os.path.abspath(args.path) if system.root == "/" else "/" + args.path.lstrip("/")
    rel = os.path.normpath(p).lstrip("/")
    hits = [n for n, m in system.installed.items()
            if any(e["path"].lstrip("/") == rel for e in m.get("file", []))]
    if not hits:
        print(f"/{rel} gehoert zu keinem Paket", file=sys.stderr)
        return 1
    for n in hits:
        print(f"/{rel} gehoert zu {n} {fullver(system.installed[n])}")
    return 0


def check_package(system, name, m):
    """Liefert (Fehler, geaenderte Konfigurationsdateien)."""
    errs, conf = [], []
    for e in m.get("file", []):
        rel = e["path"].lstrip("/")
        dst = system.path(rel)
        t = e["type"]
        if t == "dir":
            # /run ist im laufenden System ein tmpfs: Verzeichnisse darunter (z. B. /run/dbus)
            # legen Dienste beim Start an. Auf einem nicht gestarteten System (Installer,
            # vpkg --root) fehlen sie zu Recht.
            if not os.path.isdir(dst) and not (rel == "run" or rel.startswith("run/")):
                errs.append(f"{name}: Verzeichnis fehlt: /{rel}")
        elif t == "symlink":
            if not os.path.islink(dst) or os.readlink(dst) != e["target"]:
                errs.append(f"{name}: Link fehlt oder zeigt woanders hin: /{rel}")
        elif not os.path.isfile(dst) or os.path.islink(dst):
            errs.append(f"{name}: Datei fehlt: /{rel}")
        elif sha256_file(dst) != e["sha256"]:
            (conf if is_config(rel) else errs).append(f"{name}: Inhalt geaendert: /{rel}")
    return errs, conf


def cmd_rerun_script(args, system):
    system.lock()
    need(system, args.name)
    if not has_script_function(system, args.name, "post_install"):
        raise Fehler(f"{args.name} hat kein Install-Skript")
    run_install_script(system, args.name)
    info(f"Fertig: Install-Skript von {args.name} durchgelaufen.")
    return 0


def cmd_check(args, system):
    names = args.names or list(system.installed)
    errs, conf = [], []
    if os.path.isfile(system.path(TXN + "/journal")):
        errs.append(f"unterbrochener Vorgang in /{TXN}: der naechste schreibende vpkg-Aufruf "
                    "(z. B. als root: vpkg recover) nimmt ihn zurueck")
    for n in names:
        e, c = check_package(system, n, need(system, n))
        errs += e
        conf += c
        if os.path.isfile(system.path(f"{DB}/installed/{n}/{SKRIPT_FEHLER}")):
            errs.append(f"{n}: Install-Skript ist gescheitert (vpkg rerun-script {n})")
    have = provides_map(system.installed)
    for n in names:
        for d in system.installed[n].get("depends", []):
            if not satisfied(d, system.installed, have):
                dn = dep_name(d)
                if dn in system.installed:
                    errs.append(f"{n}: Abhaengigkeit {d} nicht erfuellt "
                                f"(installiert: {dn} {fullver(system.installed[dn])})")
                else:
                    errs.append(f"{n}: Abhaengigkeit fehlt: {d}")
    own = {}
    for n, m in system.installed.items():
        for e in m.get("file", []):
            if e["type"] != "dir":
                own.setdefault(e["path"], []).append(n)
    for p, ns in sorted(own.items()):
        if len(ns) > 1 and set(ns) & set(names):
            errs.append(f"{p} gehoert zu mehreren Paketen: {', '.join(ns)}")
    for c in conf:
        print(f"Konfiguration: {c}")
    for e in errs:
        print(f"FEHLER: {e}")
    print(f"{len(names)} Paket(e) geprueft: {len(errs)} Fehler, {len(conf)} geaenderte Konfigurationsdateien")
    return 1 if errs else 0


def cmd_register(args, system):
    """Traegt Pakete ein, deren Dateien schon im System liegen (z. B. beim Bau des
    Basissystems). Abweichungen werden gemeldet, aber nicht korrigiert."""
    system.lock()
    total = 0
    with tempfile.TemporaryDirectory(prefix="vpkg.") as tmp:
        def apply(txn):
            nonlocal total
            for path in args.packages:
                p = Paket(os.path.abspath(path), tmp, system.keys)
                errs, conf = check_package(system, p.name, p.m)
                for e in errs:
                    warn(e)
                total += len(errs)
                system.write_entry(p, txn)
                shutil.rmtree(p.dir)
                info(f"eingetragen: {p.name} {fullver(p.m)}"
                     + (f" ({len(errs)} Abweichungen)" if errs else ""))
        transaction(system, "Eintragen", apply)
    info(f"Fertig: {len(args.packages)} Paket(e) eingetragen, {total} Abweichungen.")
    return 1 if total and args.strict else 0


# ---------------------------------------------------------------- Aufruf

def main(argv=None):
    ap = argparse.ArgumentParser(prog="vpkg", description=f"VPKG {VERSION}: Paketverwaltung von Veyra OS")
    ap.add_argument("--root", default="/", help="Zielsystem (Standard: /)")
    ap.add_argument("--pubkey", action="append", default=[], help="zusaetzlicher oeffentlicher Schluessel")
    ap.add_argument("--version", action="version", version=f"vpkg {VERSION}")
    sub = ap.add_subparsers(dest="cmd", required=True)

    def inst_opts(p):
        p.add_argument("--repo", help="Verzeichnis oder https-Adresse mit index.toml "
                       "(statt der eingerichteten Quellen)")
        p.add_argument("--overwrite", action="store_true", help="Dateikonflikte ueberschreiben")
        p.add_argument("--no-deps", action="store_true", help="Abhaengigkeiten nicht pruefen")
        p.add_argument("--no-scripts", action="store_true", help="Install-Skripte nicht ausfuehren")
        p.add_argument("--allow-downgrade", action="store_true",
                       help="aeltere Versionen als die installierte zulassen")

    p = sub.add_parser("install", help="Pakete installieren oder aktualisieren")
    inst_opts(p)
    p.add_argument("packages", nargs="+")
    p = sub.add_parser("upgrade", help="alle Pakete aus dem Repository aktualisieren")
    inst_opts(p)
    p = sub.add_parser("remove", help="Pakete entfernen")
    p.add_argument("--no-deps", action="store_true")
    p.add_argument("--no-scripts", action="store_true", help="pre_remove nicht ausfuehren")
    p.add_argument("names", nargs="+")
    sub.add_parser("list", help="installierte Pakete")
    p = sub.add_parser("info", help="Angaben zu einem Paket")
    p.add_argument("name")
    p = sub.add_parser("files", help="Dateien eines Pakets")
    p.add_argument("name")
    p = sub.add_parser("owner", help="zu welchem Paket gehoert eine Datei")
    p.add_argument("path")
    p = sub.add_parser("rerun-script", help="post_install eines installierten Pakets erneut ausfuehren")
    p.add_argument("name")
    p = sub.add_parser("check", help="installierte Dateien pruefen")
    p.add_argument("names", nargs="*")
    p = sub.add_parser("register", help="schon ausgepackte Pakete eintragen")
    p.add_argument("--strict", action="store_true", help="Abweichungen als Fehler werten")
    p.add_argument("packages", nargs="+")
    sub.add_parser("recover", help="unterbrochenen Vorgang zuruecknehmen")
    sub.add_parser("update", help="Paketindex aller Quellen holen und pruefen")
    p = sub.add_parser("search", help="Pakete im Index suchen (Name, Beschreibung, Gruppe)")
    p.add_argument("muster")
    p = sub.add_parser("clean", help="heruntergeladene Pakete aus dem Cache loeschen")
    p.add_argument("--alles", action="store_true", help="auch die gespeicherten Paketindizes")
    p = sub.add_parser("repo", help="eingerichtete Quellen")
    p.add_argument("aktion", choices=["list"])
    p = sub.add_parser("index", help="index.toml fuer ein Repository-Verzeichnis schreiben")
    p.add_argument("--stand", type=int,
                   help="Stand des Index (Zahl, muss mit jeder Ausgabe steigen; Standard: "
                        "SOURCE_DATE_EPOCH, sonst die aktuelle Zeit)")
    p.add_argument("dir")
    args = ap.parse_args(argv)

    try:
        if args.cmd == "index":
            cmd_index(args)
            return 0
        system = System(args.root, args.pubkey)
        if args.cmd == "install":
            return cmd_install(args, system)
        if args.cmd == "upgrade":
            args.packages = []
            return cmd_install(args, system, upgrade_only=True)
        if args.cmd == "recover":
            system.lock()            # nimmt einen unterbrochenen Vorgang zurueck
            info("Kein unterbrochener Vorgang (mehr) vorhanden.")
            return 0
        return {"remove": cmd_remove, "list": cmd_list, "info": cmd_info, "files": cmd_files,
                "owner": cmd_owner, "check": cmd_check, "register": cmd_register,
                "rerun-script": cmd_rerun_script, "update": cmd_update, "search": cmd_search,
                "clean": cmd_clean, "repo": cmd_repo}[args.cmd](args, system)
    except Fehler as e:
        print(f"vpkg: {e}", file=sys.stderr)
        return 1
    except OSError as e:
        print(f"vpkg: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
