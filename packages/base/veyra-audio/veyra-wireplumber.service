[Unit]
Description=WirePlumber, Sitzungsverwaltung fuer PipeWire (systemweit, Veyra)
Documentation=man:veyra-audio(1)
After=veyra-pipewire.service
BindsTo=veyra-pipewire.service

[Service]
Type=simple
User=pipewire
Group=pipewire
SupplementaryGroups=audio
UMask=0007
StateDirectory=pipewire
Environment=XDG_RUNTIME_DIR=/run/pipewire PIPEWIRE_RUNTIME_DIR=/run/pipewire HOME=/var/lib/pipewire
ExecStart=/usr/bin/wireplumber
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=veyra-pipewire.service
