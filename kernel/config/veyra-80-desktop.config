# Desktop-Grundlage (Veyra 0.6, Phase 6): Wayland-Compositoren brauchen einen DRM-Treiber mit
# Modesetting und Eingabegeraete ueber evdev (/dev/input/event*).
# Grafikkarte von QEMU (virtio-gpu), damit der Desktop-Test im CI ein echtes Bild bekommt
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
# Tastatur und Maus von QEMU (virtio-keyboard, virtio-tablet)
CONFIG_VIRTIO_INPUT=y
# Eingabegeraete fuer libinput
CONFIG_INPUT_EVDEV=y
# Grafikkarte von VirtualBox (VMSVGA) und VMware; Mesa nutzt dafuer den Treiber svga
CONFIG_DRM_VMWGFX=y
