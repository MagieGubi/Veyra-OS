# Voraussetzungen von systemd (laut systemd README), die x86_64_defconfig nicht garantiert
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_DMIID=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_NET=y
CONFIG_UNIX=y
