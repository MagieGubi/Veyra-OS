# Energie (Veyra 0.7, veyra-power): Ruhezustand, CPU-Taktsteuerung, Akku und Netzteil.
# Die meisten Werte setzt schon x86_64_defconfig; hier stehen sie ausdruecklich, weil
# veyra-power und der Ruhezustand-Test in QEMU darauf bauen.
# Ruhezustand (Suspend-to-RAM: S3 "deep" und s2idle, das neuere Laptops nur noch anbieten)
CONFIG_SUSPEND=y
# CPU-Takt: intel_pstate (Intel ab Core 2. Generation) und amd-pstate (Zen 2 und neuer) mit
# Energie-Leistungs-Vorgabe (EPP); Regler powersave, performance und schedutil.
CONFIG_CPU_FREQ=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
# Akku, Netzteil und Deckel/Einschalttaste ueber ACPI
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BUTTON=y
# Echtzeituhr: Weckzeit fuer den Ruhezustand (/sys/class/rtc/rtc0/wakealarm)
CONFIG_RTC_DRV_CMOS=y
