# Connectivity (Veyra 0.7): Ton und Bluetooth. Treiber fuer echte Hardware als Module, damit
# sie nur auf Rechnern mit dem Geraet geladen werden.
# HD-Audio: Controller (SND_HDA_INTEL) ist schon fest drin. Der generische Codec-Treiber
# bedient u. a. den Codec von QEMU (intel-hda mit hda-duplex) fuer den Audio-Test im CI.
CONFIG_SND_HDA_GENERIC=y
# Realtek-Codecs (die meisten Laptops, darunter MSI); die ALC269-Familie umfasst ALC2xx.
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_ALC269=m
CONFIG_SND_HDA_CODEC_ALC662=m
CONFIG_SND_HDA_CODEC_ALC882=m
CONFIG_SND_HDA_CODEC_CONEXANT=m
# Ton ueber HDMI und DisplayPort (Intel-Grafik)
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_HDMI_GENERIC=m
CONFIG_SND_HDA_CODEC_HDMI_INTEL=m
# USB-Audio (Headsets, USB-Soundkarten)
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=m
# Bluetooth: Kern, klassisch und Low Energy, Profile fuer Tastaturen/Maeuse (HIDP, UHID fuer
# BLE-Eingabegeraete), USB-Controller (Intel, Realtek, MediaTek, Broadcom) und der virtuelle
# Controller hci_vhci fuer den Test im CI.
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_HIDP=m
CONFIG_UHID=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIVHCI=m
