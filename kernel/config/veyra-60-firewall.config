# nftables fuer die Firewall (Veyra 0.6, Phase 2), fest im Kernel statt als Module:
# die Regeln laden vor dem Netz, ohne dass Module nachgeladen werden muessen.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
# Zustand der Verbindung (Antworten auf eigene Verbindungen erlauben)
CONFIG_NFT_CT=y
# Ablehnen mit ICMP statt stumm verwerfen (fuer Diagnose), Begrenzung fuer Protokollzeilen
CONFIG_NFT_REJECT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
