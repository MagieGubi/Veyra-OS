# Phase 6: echte Laptops (erstes Ziel: Adrians MSI Katana 15, Intel Core 13. Generation,
# NVMe-SSD, Intel-Grafik plus NVIDIA). Start vom USB-Stick, ohne Initramfs: alles, was zum
# Finden der Root-Partition und fuer Bild und Tastatur noetig ist, fest eingebaut.
# NVMe-SSDs (interne Laptop-Platten)
CONFIG_BLK_DEV_NVME=y
# USB-Stick als Startmedium: USB-3-Controller, Massenspeicher, schnelles UAS-Protokoll
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
# Bild sofort ab Kernelstart ueber den Framebuffer der UEFI-Firmware (simpledrm), danach
# Intel-Grafik. i915 ist ein Modul (seit 0.7): ohne Initramfs findet ein fest eingebauter
# Treiber seine Firmware (DMC, GuC, HuC) nicht, weil die Root-Partition beim Start noch nicht
# eingehaengt ist. Als Modul laedt udev ihn danach, und die Firmware liegt bereit.
CONFIG_DRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_I915=m
# Eingebaute Laptop-Tastatur und USB-Tastaturen/-Maeuse
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
# Touchpad (I2C-HID ueber ACPI), als Modul, laedt udev bei Bedarf
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m
# FAT fuer die Datenpartition des USB-Sticks (Messwerte, unter Windows lesbar)
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# Intel-WLAN als Modul (braucht Firmware, die folgt mit einem eigenen Paket).
# Realtek-LAN (R8169) und HD-Audio (SND_HDA_INTEL) sind schon in x86_64_defconfig fest drin.
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
# NVIDIA bleibt vorerst aus: Veyra laeuft auf der Intel-Grafik
CONFIG_DRM_NOUVEAU=n
