# Core 0.1 bootet ohne Bootloader: die UEFI-Firmware startet den Kernel direkt als EFI-Programm
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
# Ohne Bootloader braucht der Kernel seine Kommandozeile eingebaut.
# Root-Partition per GPT-Partitionsname, Ausgabe auf serieller Konsole (fuer automatische Tests) und Bildschirm.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="root=PARTLABEL=veyra-root rootfstype=ext4 rw console=tty0 console=ttyS0,115200"
# Keine Initramfs in Core 0.1: Treiber fuer QEMU-Platte und Root-Dateisystem fest eingebaut
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
