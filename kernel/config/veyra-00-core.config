# Identitaet: uname -r zeigt z. B. 6.18.56-veyra1 (Revision wird vom Build-Skript gesetzt)
CONFIG_LOCALVERSION_AUTO=n
# Kernel-Konfiguration im laufenden System einsehbar (/proc/config.gz): Transparenz
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# Keine Debug-Infos: kleinerer Kernel, schnellerer Build (Debug-Variante spaeter separat)
CONFIG_DEBUG_INFO_NONE=y
# Modulsignierung aus: ein pro Build neu erzeugter Schluessel verhindert bit-identische Builds.
# Signierung kommt als eigener, nachgelagerter Schritt mit festem Schluessel (Phase 9).
CONFIG_MODULE_SIG=n
