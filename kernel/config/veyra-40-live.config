# Live-ISO (beide Kernel-Varianten, damit die Module gleich bleiben): das System liegt als
# SquashFS auf der CD, darueber ein beschreibbares Overlay im Arbeitsspeicher.
# Die Live-Variante unterscheidet sich nur in eingebauter Initramfs und Kommandozeile
# (build-kernel.sh, kernel/live/).
CONFIG_BLK_DEV_INITRD=y
CONFIG_ISO9660_FS=y
CONFIG_BLK_DEV_SR=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
