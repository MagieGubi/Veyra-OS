# Haertung (Veyra 0.6, Phase 2). Nur Optionen, die Linux 6.18 hat; build-kernel.sh bricht ab,
# wenn Kconfig eine davon verwirft. Werte zur Laufzeit prueft der Selbsttest.
# Stack-Schutz fuer alle Funktionen mit Puffern
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
# Laufzeitpruefung von Puffergroessen bei memcpy/strcpy und Co.
CONFIG_FORTIFY_SOURCE=y
# Kopien zwischen Kernel und Programmen auf Objektgrenzen pruefen
CONFIG_HARDENED_USERCOPY=y
# Neuer Kernel-Speicher wird genullt (verhindert Lecks alter Inhalte)
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
# Kernel-Adressen zufaellig (KASLR)
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
# Code schreibgeschuetzt, Daten nicht ausfuehrbar
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
# Freilisten des Slab-Allokators zufaellig und geprueft, Seitenvergabe gemischt
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
# Verkettete Listen pruefen, bei kaputten Strukturen anhalten statt weiterlaufen
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
# /dev/mem nur fuer Geraetespeicher, nicht fuer normalen RAM
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y
# Kein Einschleusen von Eingaben in fremde Terminals (TIOCSTI)
CONFIG_LEGACY_TIOCSTI=n
# Sicherheitsmodul Yama: ptrace nur auf eigene Kindprozesse. Lockdown fehlt bewusst: es
# erzwingt CONFIG_MODULE_SIG (CI-Lauf 44254846361), und das bricht den bit-identischen
# Build; Lockdown kommt mit Secure Boot und festem Signaturschluessel.
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
# /sys/kernel/security (welche Sicherheitsmodule aktiv sind; systemd haengt es ein)
CONFIG_SECURITYFS=y
