# WLAN (Veyra 0.6, Phase 5): cfg80211 und mac80211 als Module statt fest eingebaut. Sie laden
# dann erst mit dem WLAN-Treiber, wenn die Root-Partition eingehaengt ist, und finden so
# regulatory.db (Paket wireless-regdb, signiert, geprueft mit dem im Kernel eingebauten
# Schluessel) und die Firmware unter /usr/lib/firmware.
CONFIG_CFG80211=m
CONFIG_MAC80211=m
# Virtuelle Funkgeraete fuer den Test von iwd in QEMU (wird nur im Test geladen)
CONFIG_MAC80211_HWSIM=m
# iwd nutzt die Kryptografie des Kernels (AF_ALG und Schluesselbund) statt eigener
# Bibliotheken; ohne diese Optionen startet iwd nicht oder kann sich nicht anmelden.
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DES=y
